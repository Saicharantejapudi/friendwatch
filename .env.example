# FriendWatch Environment Configuration
PORT=5000
JWT_SECRET=super_secret_jwt_key_friendwatch_2026
NODE_ENV=development

# Cloud Database: MongoDB Atlas (Optional)
# If provided, FriendWatch connects to your MongoDB Atlas cluster.
# If omitted or offline, FriendWatch automatically falls back to local data/users.json
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/friendwatch?retryWrites=true&w=majority
